{
	"listen_addr": ":8443",
	"runtime": {
		"mode": "strict"
	},
	"auth": {
		"require_device": true,
		"require_user": true,
		"jwt_signing_key": "env:SECURE_HTTP_JWT_SIGNING_KEY",
		"session_cookie": {
			"enabled": true,
			"name": "securehttp_access",
			"path": "/",
			"domain": "",
			"http_only": true,
			"secure": true,
			"same_site": "lax"
		},
		"csrf": {
			"enabled": true,
			"cookie_name": "securehttp_csrf",
			"header_name": "X-CSRF-Token",
			"path": "/",
			"domain": "",
			"secure": true,
			"same_site": "lax"
		}
	},
	"gate": {
		"max_clock_skew": "15s",
		"nonce_ttl": "90s",
		"allowed_origins": [
			"https://app.example.com"
		],
		"strict_origin": true,
		"rate_limit": {
			"window": "15s",
			"max_hits": 20
		},
		"secrets": [
			{
				"id": "prod-2026-q2",
				"secret": "env:SECURE_HTTP_GATE_SECRET_Q2",
				"not_before": "2026-01-01T00:00:00Z",
				"expires_at": "2027-01-01T00:00:00Z"
			}
		]
	},
	"capabilities": [
		{
			"token": "env:SECURE_HTTP_TODO_CAPABILITY_TOKEN",
			"routes": [
				{ "path": "/handshake", "methods": [ "POST" ] },
				{ "path": "/auth/bootstrap", "methods": [ "POST" ] },
				{ "path": "/auth/logout", "methods": [ "POST" ] },
				{ "path": "/api/todos", "methods": [ "GET", "POST" ] },
				{ "path": "/api/todos/*", "methods": [ "PUT", "DELETE" ] }
			]
		}
	],
	"devices": [
		{ "id": "seed-device", "secret": "env:SECURE_HTTP_SEED_DEVICE_SECRET" }
	],
	"users": [
		{
			"token": "env:SECURE_HTTP_USER_TOKEN_ALICE",
			"id": "todo-alice",
			"roles": [ "todo-user" ],
			"metadata": { "username": "alice" }
		},
		{
			"token": "env:SECURE_HTTP_USER_TOKEN_BOB",
			"id": "todo-bob",
			"roles": [ "todo-user" ],
			"metadata": { "username": "bob" }
		}
	],
	"alerts": {
		"log_file": "storage/logs/todo-audit.log",
		"webhook_url": "",
		"min_interval": "5s",
		"include_events": [ ]
	},
	"proxy": {
		"trusted_cidrs": [],
		"forwarded_for_header": "X-Forwarded-For",
		"forwarded_proto_header": "X-Forwarded-Proto"
	}
}
