{
  "name": "secure-http/php-demo-server",
  "description": "Composer-based demo server for the Secure HTTP PHP SDK.",
  "type": "project",
  "license": "proprietary",
  "repositories": [
    {
      "type": "path",
      "url": "../../sdks/server/php",
      "options": {
        "symlink": true
      }
    }
  ],
  "require": {
    "php": "^8.1",
    "oarkflow/secure-http-server-sdk": "dev-main"
  },
  "scripts": {
    "serve": "php -S 127.0.0.1:9080 -t public public/index.php"
  }
}
